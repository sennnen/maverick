/* On-device analytics. Draft copy: every one of these describes a state of the computation,
   never a health claim, and the model outputs behind them are provisional. */
"analytics.title" = "On-device analysis";
"analytics.subtitle" = "Everything here is computed on this phone. Nothing is sent anywhere.";
"analytics.entry.detail" = "What the models on this phone can work out";
"analytics.state.idle" = "Not started";
"analytics.state.working" = "Analysing %d of %d";
"analytics.state.ready" = "Up to date";
"analytics.state.stale" = "New data since this ran";
"analytics.state.deferred" = "Waiting for a quiet moment";
"analytics.state.failed" = "Could not finish";
"analytics.state.computedNotShown" = "Computed — no reading to show yet";
/* Some of the input was substituted, so the reading stands but is qualified. Draft copy. */
"analytics.state.readyPartial" = "Up to date — based on partial data";
/* The model answered, but every reading behind it fell outside the range this model accepts, so
   the answer is arithmetic on padding rather than a reading. Draft copy. */
"analytics.state.unfoundedOutOfRange" = "Not enough usable data — your readings are outside the range this model accepts";
/* Same, but the readings were never taken rather than rejected. Draft copy. */
"analytics.state.unfoundedMissing" = "Not enough data recorded yet to compute this";
"analytics.retry" = "Try again";
"analytics.needsSensor" = "Needs a sensor this device does not have: %@";
"analytics.needsProfile" = "Add your %@ to enable this";
"analytics.needsUpstream" = "Waiting on %@";
"analytics.notPorted" = "Not available in this build: %@";
"analytics.permissionRequired" = "Needs permission: %@";
"analytics.empty" = "No analysis has run yet";
"analytics.coverage" = "%d of %d models can run here";
"analytics.a11y.signal" = "%1$@, %2$@. %3$@";
"analytics.a11y.working" = "Analysis in progress";
"analytics.a11y.retry" = "Retry analysis for %@";

