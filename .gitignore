*.swp
*~

/apps/ios/build
# Generated from apps/ios/project.yml by XcodeGen on every build, and not reproducible outside a
# fully built tree: it lists the uniffi bindings that build/mav-core/Sources holds, so the same
# spec produces a different project before and after the core is built. Committing it meant
# committing a file nobody could regenerate identically. `tools/platform/build_ios_app.sh` makes
# it; `xcodegen generate` in apps/ios is enough to open the project on its own.
/apps/ios/Maverick.xcodeproj
/apps/android/build
/apps/android/app/build
/apps/android/.gradle
/apps/android/local.properties
*.xcuserstate
xcuserdata/

*.sqlite
*.sqlite-wal
*.sqlite-shm
/scratch

# Local-only conversion inputs: the archives and the two interpreter environments the
# model pipeline runs in. Neither is redistributable and neither is small.
/tools/decrypted_models
/tools/ml/.venv
/tools/ml/.venv-tf
/tools/ml/out
/tools/ml/pulseppg_repo
/tools/ml/pulseppg_weights
# Transcripts of a conversion run. Useful while a run is being debugged, meaningless once the
# contracts and the manifest it produced are committed.
/tools/ml/out_*.log

__pycache__/
*.pyc
